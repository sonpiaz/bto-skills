#!/bin/sh
# Link moi skill trong repo nay vao ~/.claude/skills/ de Claude Code tu nhan.
# Chay lai bao nhieu lan cung an toan. Khong dung neu ban da co skill trung
# ten do chinh ban viet: script se bo qua va bao ro.
set -e

SRC="$(cd "$(dirname "$0")" && pwd)"
DEST="$HOME/.claude/skills"
mkdir -p "$DEST"

for d in "$SRC"/*/; do
  name="$(basename "$d")"
  [ -f "$d/SKILL.md" ] || continue
  # Ten cu (vd bto-secrets) chi la symlink toi ten moi, de may da cai van chay.
  # Khong link them ten cu, va go link ten cu da cai, de khong co hai skill trung nhau.
  if [ -L "$SRC/$name" ]; then
    if [ -L "$DEST/$name" ] && [ "$(readlink "$DEST/$name")" = "$SRC/$name" ]; then
      rm "$DEST/$name"
      echo "go ten cu $name (da doi sang $(readlink "$SRC/$name"))"
    fi
    continue
  fi
  target="$DEST/$name"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "bo qua $name: $target da ton tai va khong phai do bto-skills tao ra"
    continue
  fi
  ln -sfn "$SRC/$name" "$target"
  echo "da link $name"
done

echo ""
echo "Xong. Mo mot phien Claude Code moi de agent nhan skill."
echo "Kiem tra: hoi agent 'toi sap noi mot API moi, co luat nao phai theo khong'"
